# Backend environment variables — copy to .env and fill in real values.
# In production (e.g. Render), set these in the host's environment settings.

# MongoDB connection string
MONGO_DB_URI=mongodb+srv://<user>:<password>@<cluster>/<db>?retryWrites=true&w=majority

# Port the server listens on
PORT=8000

# REQUIRED: secret used to sign/verify JWTs. The server refuses to start if unset.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Redis connection (required — used by the crawl job queue and progress relay)
REDIS_URL=redis://127.0.0.1:6379

# Comma-separated list of allowed CORS origins (API + Socket.IO)
CORS_ORIGINS=https://auto-crawler.vercel.app,http://localhost:5173

# How many crawl jobs a worker process runs concurrently (1-10)
CRAWL_CONCURRENCY=3

# Log level: trace | debug | info | warn | error
LOG_LEVEL=info

# LLM extraction (Track A) — set a key to enable AI extraction
# ANTHROPIC_API_KEY=sk-ant-...
LLM_MODEL=claude-sonnet-5

# Crawler politeness & access (Track B)
CRAWLER_USER_AGENT=AutoCrawlerBot
CRAWLER_INFO_URL=https://your-site.example/crawler
# Minimum ms between requests to the same host (per-host throttle)
CRAWL_MIN_HOST_INTERVAL_MS=1000
# Set to 'true' to launch Puppeteer with the stealth plugin
STEALTH_ENABLED=false
# Comma-separated proxy URLs, rotated per request (e.g. http://user:pass@host:port)
PROXY_URLS=
# 32-byte key (hex or base64) for encrypting stored auth sessions at rest.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_ENC_KEY=

# n8n webhook integration (optional)
N8N_ENABLED=false
N8N_WEBHOOK_URL=http://localhost:5678/webhook/crawl-complete
